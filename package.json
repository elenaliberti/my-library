{
  "name": "my-library",
  "version": "1.7.0",
  "description": "Personal reading tracker for fanfiction and books",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.mylibrary.app",
    "productName": "My Library",
    "mac": {
      "category": "public.app-category.books",
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!library-data.json",
      "!.claude/**",
      "!*.md",
      "!setup.sh",
      "!*.log"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
